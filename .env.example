# Local dev default (SQLite file, zero setup):
DATABASE_URL="file:./dev.db"

# For production on Vercel, create a free Postgres database at
# https://neon.tech or https://supabase.com, then set this to the
# connection string it gives you, and change the provider in
# prisma/schema.prisma from "sqlite" to "postgresql".
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Set to your deployed URL in production, e.g. https://your-site.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Optional: "Continue with Google" sign-in. Leave blank to skip it — the app
# works fine with just email/password if you don't set these up.
# Get these from https://console.cloud.google.com/apis/credentials
# (create an OAuth 2.0 Client ID, web application type). See README.md.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Required for admins to upload book files (PDF/EPUB) from the dashboard.
# Free tier at https://supabase.com — create a project, then Storage → create
# a public bucket named "book-files". Get these values from
# Project Settings → API. See README.md for the full walkthrough.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Required for "forgot password" reset emails. Free tier at
# https://resend.com — sign up, create an API key. See README.md.
# Without this set, reset links are logged to the server console instead of
# emailed, which is fine for local testing but not for real use.
RESEND_API_KEY=""
# Must be a verified sender/domain in your Resend account. Their shared
# "onboarding@resend.dev" address works for testing without a custom domain.
EMAIL_FROM="All Booked <onboarding@resend.dev>"

# Note: the club's registration access code is NOT set here — it lives in
# the database and is managed from Admin dashboard → Club settings. It
# defaults to 572157 the first time the app runs.
